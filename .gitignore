# 환경변수 (절대 커밋 금지)
.env

# OS
.DS_Store

# TLS 인증서 (절대 커밋 금지)
broker/certs/*.crt
broker/certs/*.key
broker/certs/*.pem
broker/certs/*.p12
broker/certs/*.srl
broker/certs/vehicles/

# Compiled class file
*.class

# Log file
*.log

# BlueJ files
*.ctxt

# Mobile Tools for Java (J2ME)
.mtj.tmp/

# Package Files #
*.jar
*.war
*.nar
*.ear
*.zip
*.tar.gz
*.rar

# Gradle Wrapper jar는 예외 — 이게 없으면 클론 후 ./gradlew가 동작하지 않는다.
!backend/gradle/wrapper/gradle-wrapper.jar

# virtual machine crash logs, see http://www.java.com/en/download/help/error_hotspot.xml
hs_err_pid*
replay_pid*

# 빌드 산출물 / IDE
backend/build/
backend/.gradle/
backend/data/
.idea/
.claude/
__pycache__/

# 실험 스크립트의 전체 콘솔 출력은 로컬 진단용이며 Git에 추적하지 않는다.
# 재현에 필요한 핵심 로그는 evidence/<run-id>/의 요약 파일로 보존한다. 전체 로그가
# 필요하면 외부 저장 위치와 별도 checksum을 결과 문서에 기록한다.
load-test/**/_result*.txt
