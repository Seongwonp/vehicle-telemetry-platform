# 환경변수 (절대 커밋 금지)
.env

# OS
.DS_Store

# TLS 인증서 (절대 커밋 금지)
broker/certs/*.crt
broker/certs/*.key
broker/certs/*.pem
broker/certs/*.p12
broker/certs/*.srl
broker/certs/vehicles/

# Compiled class file
*.class

# Log file
*.log

# BlueJ files
*.ctxt

# Mobile Tools for Java (J2ME)
.mtj.tmp/

# Package Files #
*.jar
*.war
*.nar
*.ear
*.zip
*.tar.gz
*.rar

# Gradle Wrapper jar는 예외 — 이게 없으면 클론 후 ./gradlew가 동작하지 않는다.
!backend/gradle/wrapper/gradle-wrapper.jar

# virtual machine crash logs, see http://www.java.com/en/download/help/error_hotspot.xml
hs_err_pid*
replay_pid*

# 빌드 산출물 / IDE
backend/build/
backend/.gradle/
backend/data/
.idea/
.claude/
__pycache__/

# 실험 스크립트의 콘솔 출력. 보존이 필요한 것은 evidence/<run-id>/console.log에
# 복사되므로 작업 트리의 원본은 추적하지 않는다.
load-test/**/_result*.txt
