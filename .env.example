# ================================================================
# Vehicle Telemetry Platform — 환경변수 설정
# 이 파일을 복사해서 .env 로 만들고 실제 값을 채워넣으세요
# cp .env.example .env
# ================================================================

# ── MQTT 브로커 (Mosquitto) ──────────────────────────────────────
MQTT_TLS_PORT=8883

# ── Kafka ────────────────────────────────────────────────────────
KAFKA_PORT=9092

# ── InfluxDB (시계열 DB) ─────────────────────────────────────────
INFLUXDB_PORT=8086
INFLUXDB_USERNAME=admin
INFLUXDB_PASSWORD=change_me_influx_password
INFLUXDB_ORG=vehicle-telemetry
INFLUXDB_BUCKET=telemetry
INFLUXDB_TOKEN=change_me_influxdb_admin_token_min_32chars

# ── PostgreSQL (관계형 DB) ────────────────────────────────────────
POSTGRES_PORT=5432
POSTGRES_DB=telemetry
POSTGRES_USER=telemetry_user
POSTGRES_PASSWORD=change_me_postgres_password

# ── Redis (캐시 / Rate Limiting) ─────────────────────────────────
REDIS_PORT=6379
REDIS_PASSWORD=change_me_redis_password

# ── Spring Boot 백엔드 ───────────────────────────────────────────
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
INFLUXDB_URL=http://localhost:8086

# ── Grafana ──────────────────────────────────────────────────────
GRAFANA_PORT=3000
GRAFANA_USER=admin
GRAFANA_PASSWORD=changeme

# ── 이상 감지 모듈 ───────────────────────────────────────────────
ML_ENABLED=false
ML_MIN_SAMPLES=200
# 학습 윈도우 크기(건수). 시간으로 몇 초를 덮는지는 처리량에 좌우된다.
ML_WINDOW_SIZE=2000
# 이상 판정 점수 임계값(비워두면 모델 offset_ = 항상 contamination 비율만큼 알림).
# 정상 구간 데이터로 score_ml.py --sweep을 돌려 정할 것.
ML_SCORE_THRESHOLD=
# 측정 전용: ML 이상 점수를 메시지마다 로그로 남긴다(score_ml.py --sweep 입력).
# 처리량이 떨어지므로 상시 켜두지 말 것.
ML_SCORE_DUMP=false
WEBHOOK_URL=

# ── Gemini AI 진단 (Phase 9) ──────────────────────────────────────
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
GEMINI_CACHE_TTL_MS=300000
GEMINI_MAX_CONCURRENT_CALLS=4
GEMINI_CIRCUIT_FAILURE_THRESHOLD=3
GEMINI_CIRCUIT_OPEN_MS=60000
DIAGNOSIS_RATE_LIMIT_RPH=5

# ── Phase 4 TLS — 시뮬레이터(Python, PEM) 로컬 실행용 경로 ────────
TLS_CA_CERT=
TLS_CLIENT_CERT=
TLS_CLIENT_KEY=

# ── Phase 4 TLS — 시뮬레이터를 docker-compose --profile simulator로 띄울 때 쓰는 컨테이너 내부 경로 ──
SIMULATOR_TLS_CA_CERT=/app/certs/ca.crt
TLS_VEHICLE_CERT_DIR=/app/certs/vehicles

# ── Phase 10 TLS — Spring Boot 백엔드(Java, PKCS12) ───────────────
# broker/certs/generate-certs.sh 실행 + broker/config/mosquitto.conf TLS 섹션
# 기본 Compose는 인증서가 준비된 mTLS 모드다. 평문 개발은 docker-compose.dev.yml을 명시한다.
MQTT_TLS_ENABLED=true
MQTT_TLS_KEYSTORE_PATH=../broker/certs/backend.p12
MQTT_TLS_TRUSTSTORE_PATH=../broker/certs/truststore.p12
MQTT_TLS_STORE_PASSWORD=changeit
MQTT_VEHICLE_IDS=SIM-001,SIM-002,SIM-003

# ── 차량 시뮬레이터 ──────────────────────────────────────────────
VEHICLE_COUNT=3
PUBLISH_INTERVAL=1.0
ANOMALY_RATE=0.02

# ── Spring Boot API ──────────────────────────────────────────────
SERVER_PORT=8080
JWT_SECRET=change_me_jwt_secret_key_must_be_at_least_32_characters
JWT_EXPIRATION_MS=600000
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change_me_admin_password
RATE_LIMIT_RPM=60
LOGIN_RATE_LIMIT_RPM=10
TRUSTED_PROXY_IPS=
TRIP_DEFAULT_HOURS=1
TRIP_POINT_LIMIT=10000
TRIP_GAP_THRESHOLD=3m
TRIP_MIN_POINTS=3
TRIP_MAX_GPS_SPEED_KMH=250

# ── CORS (Flutter web에서 백엔드 호출 시 필요, 네이티브 앱/curl은 무관) ───
CORS_ALLOWED_ORIGINS=http://localhost:*,http://127.0.0.1:*
# spool 재전송 배치 크기(retry-ms와 곱해져 드레인 속도 상한이 된다)
TELEMETRY_SPOOL_RETRY_BATCH=10000
